<?php

namespace App\Builders;

use App\Models\Category;
use App\Models\ProductReview;
use App\Models\ProductSupplier;
use App\Models\Supplier;
use Illuminate\Database\Eloquent\Builder;

final class ProductBuilder extends Builder
{
    public function active(): self
    {
        return $this->where('is_active', true);
    }

    public function published(): self
    {
        return $this
            ->whereNotNull('published_at')
            ->where('published_at', '<=', now());
    }

    public function inStock(): self
    {
        return $this->where('stock', '>', 0);
    }

    public function search(string $term): self
    {
        return $this->where(function (Builder $query) use ($term): void {
            $query
                ->where('name', 'like', "%{$term}%")
                ->orWhere('sku', 'like', "%{$term}%")
                ->orWhere('description', 'like', "%{$term}%");
        });
    }

    public function priceBetween(float $minimum, float $maximum): self
    {
        return $this->whereBetween('price', [$minimum, $maximum]);
    }

    public function inCategory(Category|int $category): self
    {
        return $this->where('category_id', $category instanceof Category ? $category->getKey() : $category);
    }

    public function taggedWith(string ...$slugs): self
    {
        return $this->when(
            $slugs !== [],
            fn (self $query): self => $query->whereHas(
                'tags',
                fn (Builder $tagQuery): Builder => $tagQuery->whereIn('slug', $slugs)
            )
        );
    }

    public function availableFrom(Supplier|int $supplier): self
    {
        $supplierId = $supplier instanceof Supplier ? $supplier->getKey() : $supplier;

        return $this->whereHas('suppliers', function (Builder $query) use ($supplierId): void {
            $query
                ->whereKey($supplierId)
                ->where('product_supplier.is_active', true);
        });
    }

    public function withCatalogMetrics(): self
    {
        return $this
            ->withCount([
                'reviews as approved_reviews_count' => fn (Builder $query): Builder => $query->whereNotNull('approved_at'),
            ])
            ->withAvg([
                'reviews as average_rating' => fn (Builder $query): Builder => $query->whereNotNull('approved_at'),
            ], 'rating')
            ->addSelect([
                'last_review_at' => ProductReview::query()
                    ->select('created_at')
                    ->whereColumn('product_id', 'products.id')
                    ->whereNotNull('approved_at')
                    ->latest()
                    ->limit(1),
                'lowest_supplier_price' => ProductSupplier::query()
                    ->select('negotiated_price')
                    ->whereColumn('product_id', 'products.id')
                    ->where('is_active', true)
                    ->orderBy('negotiated_price')
                    ->limit(1),
            ])
            ->withCasts([
                'average_rating' => 'decimal:2',
                'last_review_at' => 'datetime',
                'lowest_supplier_price' => 'decimal:2',
            ]);
    }

    public function orderByLatestReview(): self
    {
        return $this->orderByDesc(
            ProductReview::query()
                ->select('created_at')
                ->whereColumn('product_id', 'products.id')
                ->whereNotNull('approved_at')
                ->latest()
                ->limit(1)
        );
    }
}
